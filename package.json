{
  "name": "gopherkind",
  "version": "2.0.0",
  "description": "Gopherholes served from Nostr relays, and a gopher client that speaks Nostr. Publish once, mirrored everywhere, signed by your npub.",
  "type": "module",
  "license": "MIT",
  "author": "TheCryptoDonkey",
  "keywords": [
    "nostr",
    "gopher",
    "gemini",
    "rfc1436",
    "phlog",
    "gopherhole",
    "gopherkind",
    "nip-46",
    "bridge",
    "cli"
  ],
  "homepage": "https://github.com/forgesworn/gopherkind#readme",
  "bugs": {
    "url": "https://github.com/forgesworn/gopherkind/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/gopherkind.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gopherkind": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "SPEC.md",
    "docs/bridge-profile.md",
    "docs/conformance.md",
    "test/fixtures/kind31436-v1.json",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "serve": "node src/cli.ts serve"
  },
  "dependencies": {
    "nostr-tools": "2.23.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
