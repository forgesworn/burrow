{
  "name": "gopherkind",
  "version": "0.16.7",
  "description": "Signed gopherholes on Nostr relays, with Gopher, Gemini, HTTP and CLI readers.",
  "type": "module",
  "license": "MIT",
  "author": "TheCryptoDonkey",
  "keywords": [
    "nostr",
    "gopher",
    "gemini",
    "rfc1436",
    "phlog",
    "gopherhole",
    "gopherkind",
    "nip-46",
    "bridge",
    "cli"
  ],
  "homepage": "https://gopherkind.com/project/",
  "bugs": {
    "url": "https://github.com/forgesworn/gopherkind/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgesworn/gopherkind.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "gopherkind": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SPEC.md",
    "docs",
    "test/fixtures/kind31436-v1.json",
    "test/fixtures/kind31436-v2.json",
    "test/fixtures/kind31436-v3.json",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run coverage",
    "coverage": "node --test test/*.test.ts --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-lines=75 --test-coverage-branches=75 --test-coverage-functions=75",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "assets:build": "node scripts/build-assets.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run coverage",
    "serve": "node src/cli.ts serve"
  },
  "dependencies": {
    "nostr-tools": "2.23.9",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
